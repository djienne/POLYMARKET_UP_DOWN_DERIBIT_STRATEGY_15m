# Copy to .env only when absent. Never commit credentials or an existing .env.
# Compose overrides these paths and service URLs for the container.
RESULTS_DIR=../BTC_pricer_15m/results
CONFIG_DIR=../BTC_pricer_15m
REDIS_URL=redis://redis:6379/0

# The view follows this setting regardless of worker liveness.
MODE=dry_run
# Fallback only; live parameters resolve their matching grid instance.
DEFAULT_INSTANCE_ID=1271

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8798
POLL_INTERVAL_SECONDS=0.5
STATE_POLL_INTERVAL_SECONDS=1
LEADERBOARD_POLL_INTERVAL_SECONDS=30
CALIBRATION_TIMEOUT_SECONDS=360

# Fixed-grid probability-log adapter; no direct Docker socket in the dashboard.
DOCKER_CONTAINER=btc_pricer_15m_grid
DOCKER_LOGS_URL=http://docker-logs:8799
DOCKER_POLL_INTERVAL_SECONDS=1
POLYMARKET_PROBE_INTERVAL_SECONDS=30

# Optional HTTP/WebSocket data token. Keep localhost binding when unset.
# DASHBOARD_API_TOKEN=replace_with_a_private_token
LOG_LEVEL=INFO
